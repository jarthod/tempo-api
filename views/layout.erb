<!DOCTYPE html>
<html lang='fr'>
<head>
  <meta charset='utf-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1'>
  <title><%= h(@title || "Temp'Orb - Configuration en ligne") %></title>
  <% if @noindex %>
    <meta name='robots' content='noindex, nofollow'>
  <% else %>
    <meta name='description' content="Page de configuration en ligne pour Temp'Orb. Changement de contrat et paramétrages avancés.">
    <link rel='canonical' href='https://config.temporb.fr/'>
  <% end %>
  <link rel='icon' href='/icon.svg'>
  <link rel='stylesheet' href='/style.css'>
</head>
<body class='<%= @body_class %>'>
  <div class='wrapper'>
    <header>
      <h1 class='header'><%= @heading || "Configuration de votre Temp'Orb" %></h1>
      <% if @introduction %>
        <p class='introduction'><%= @introduction %></p>
      <% end %>
    </header>

    <main>
      <% session.delete('flash')&.each do |type, message| %>
        <p class='flash <%= type %>' role='status'><%= h(message) %></p>
      <% end %>
      <%= yield %>
    </main>

    <footer>
      <b>Fait avec le ❤️ en <span class='fr-flag-part blue'></span><span class='fr-flag-part white'></span><span class='fr-flag-part red'></span></b><br>
      Thomas Borie - 2025-2026
    </footer>
  </div>
</body>
</html>
